<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RequiresManagedContext>true</RequiresManagedContext>
    <RequiresGameReferences>true</RequiresGameReferences>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <ProjectReference Include="$(SeaPowerClientSource)/managed/SeaPower.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameManaged)/../../BepInEx/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameManaged)/../../BepInEx/core/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Seapower-Scripts">
      <HintPath>$(GameManaged)/Seapower-Scripts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Plugins">
      <HintPath>$(GameManaged)/Plugins.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Libraries">
      <HintPath>$(GameManaged)/Libraries.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
